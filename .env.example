# Copy to .env and fill in real values. .env is gitignored and never committed.
# docker-compose reads this file automatically for ${VAR} interpolation.

# --- Source PostgreSQL (OLTP) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=public

# --- Source MySQL (OLTP, second source) ---
# MYSQL_DATABASE must match schema_name_default in config/mysql_table_list.yaml,
# and MYSQL_USER/MYSQL_PASSWORD must match the MYSQL_* Airflow Variables.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=deso
MYSQL_USER=deso
MYSQL_PASSWORD=change-me

# --- ClickHouse (OLAP sink) ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me

# --- MinIO (S3A object store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# --- Airflow metadata DB ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow

# --- Airflow web admin user (created on init) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Shared secret across webserver/scheduler/worker (fixes log serving 403).
# Generate with: openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-openssl-rand-hex-32

# --- Observability (opt-in `monitoring` profile; both have compose defaults) ---
# Set True ONLY when running `docker compose --profile monitoring up` so Airflow's StatsD
# target (statsd-exporter) exists; leave False for the default stack.
AIRFLOW_STATSD_ON=False
GRAFANA_ADMIN_PASSWORD=admin
