<clickhouse>
    <!-- See also the files in users.d directory where the settings can be overridden. -->

    <!-- Profiles of settings. -->
    <profiles>
        <!-- Default settings. -->
        <default>
        </default>

        <!-- Profile that allows only read queries. -->
        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <!-- Users and ACL. -->
    <users>
        <!-- 'default' is intentionally DISABLED. This project's only working ClickHouse
             credential is CLICKHOUSE_USER/CLICKHOUSE_PASSWORD (docker-compose.yml), which the
             official image's entrypoint auto-creates with full privileges via
             CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1, entirely independent of this file. Both
             dbt (dbt/profiles.yml: env_var('CLICKHOUSE_USER')) and the Airflow Connection
             (airflow-init.sh, conn-login set to CLICKHOUSE_USER) already use only that account;
             nothing in this codebase authenticates as 'default'.

             Previously 'default' shipped with an EMPTY password, <ip>::/0</ip> (open to any
             network), and access_management=1 (can create users / grant rights): an
             unauthenticated remote admin account, reachable on the published 8123/9009 ports.
             Neutralized below via an unreachable password hash, loopback-only network, and
             access_management off, rather than just adding a password, since nothing needs
             this account to actually work. See users.d/ to reverse this if that ever changes. -->
        <default>
            <!-- SHA256 of 32 cryptographically random bytes nobody knows (generated with
                 Python's secrets module, not a hash of any word/phrase): this account can
                 never log in with a password. Combined with the loopback-only network below,
                 'default' cannot be reached at all from another container (db_network) or the
                 host. -->
            <password_sha256_hex>a808b94a791ac3617616a074273c7a7f3f2e8d7185974a00f9de5d44fd96c597</password_sha256_hex>

            <!-- Loopback only: unreachable from db_network or a published host port. -->
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>

            <!-- Settings profile for user. -->
            <profile>default</profile>

            <!-- Quota for user. -->
            <quota>default</quota>

            <!-- No admin rights: this account is unreachable, so it should also carry none. -->
            <access_management>0</access_management>
            <named_collection_control>0</named_collection_control>
        </default>
    </users>

    <!-- Quotas. -->
    <quotas>
        <!-- Name of quota. -->
        <default>
            <!-- Limits for time interval. You could specify many intervals with different limits. -->
            <interval>
                <!-- Length of interval. -->
                <duration>3600</duration>

                <!-- No limits. Just calculate resource usage for time interval. -->
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>