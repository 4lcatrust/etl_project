# ---------- Scala bronze-extractor build stage ----------
# Compiles the Phase B bronze-extract JAR (spark/scala/) so it lands in /opt/extra-jars
# alongside the other job dependencies. Client mode (B1): the driver runs in this image
# (airflow_worker), so it needs the jar locally. Cluster mode (B2): the spark_jars_init
# service copies this same /opt/extra-jars into the spark_extra_jars volume, which
# spark-worker-1 mounts so the driver it hosts can reach the jars.
FROM sbtscala/scala-sbt:eclipse-temurin-17.0.19_10_1.12.13_2.13.18 AS scala-builder
WORKDIR /build
COPY spark/scala/ .
RUN sbt -batch assembly

# Python 3.10 to match the apache/spark:4.0.3 executors (PySpark requires the
# driver and workers to run the same Python minor version).
FROM apache/airflow:2.10.5-python3.10

USER root
WORKDIR /opt/airflow

# System packages + Java 17 (spark-submit needs a JRE) + procps (ps, used by spark scripts)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        gcc \
        curl \
        wget \
        procps \
        openjdk-17-jre-headless \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Spark 4.0.3 client distribution — provides the spark-submit that SparkSubmitOperator
# invokes. Version matches the apache/spark:4.0.3 cluster. Extra jars (postgres JDBC,
# hadoop-aws) are resolved at submit time via spark.jars.packages, so none are baked here.
ARG SPARK_VERSION=4.0.3
ENV SPARK_HOME=/opt/spark
RUN set -eux; \
    curl -fSL "https://dlcdn.apache.org/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz" -o /tmp/spark.tgz \
    || curl -fSL "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz" -o /tmp/spark.tgz; \
    mkdir -p "${SPARK_HOME}"; \
    tar -xzf /tmp/spark.tgz -C "${SPARK_HOME}" --strip-components=1; \
    rm /tmp/spark.tgz; \
    test -x "${SPARK_HOME}/bin/spark-submit"
ENV PATH="${SPARK_HOME}/bin:${PATH}"

# Bake the S3A + JDBC jars into the image instead of resolving them via Ivy at
# submit time (the ~558MB AWS SDK bundle is too fragile to pull on every run).
# The DAG ships these to executors with --jars.
ARG HADOOP_AWS_VERSION=3.4.1
ARG AWS_SDK_BUNDLE_VERSION=2.24.6
ARG POSTGRES_JDBC_VERSION=42.7.5
ARG MYSQL_JDBC_VERSION=8.4.0
RUN set -eux; mkdir -p /opt/extra-jars; cd /opt/extra-jars; \
    curl -fSL --retry 5 --retry-delay 10 --retry-all-errors -O \
      "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar"; \
    curl -fSL --retry 5 --retry-delay 10 --retry-all-errors -O \
      "https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/${AWS_SDK_BUNDLE_VERSION}/bundle-${AWS_SDK_BUNDLE_VERSION}.jar"; \
    curl -fSL --retry 5 --retry-delay 10 --retry-all-errors -O \
      "https://repo1.maven.org/maven2/org/postgresql/postgresql/${POSTGRES_JDBC_VERSION}/postgresql-${POSTGRES_JDBC_VERSION}.jar"; \
    curl -fSL --retry 5 --retry-delay 10 --retry-all-errors -O \
      "https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/${MYSQL_JDBC_VERSION}/mysql-connector-j-${MYSQL_JDBC_VERSION}.jar"; \
    ls -la /opt/extra-jars

# Iceberg Spark runtime for Spark 4.0 / Scala 2.13
ARG ICEBERG_VERSION=1.10.2
ARG SPARK_VERSION_SHORT=4.0
ARG SCALA_VERSION=2.13
RUN set -eux; cd /opt/extra-jars; \
    curl -fSL --retry 5 --retry-delay 10 --retry-all-errors -O \
      "https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-${SPARK_VERSION_SHORT}_${SCALA_VERSION}/${ICEBERG_VERSION}/iceberg-spark-runtime-${SPARK_VERSION_SHORT}_${SCALA_VERSION}-${ICEBERG_VERSION}.jar"; \
    ls -la /opt/extra-jars

# Bronze-extractor JAR, compiled in the scala-builder stage above.
COPY --from=scala-builder /build/target/scala-2.13/*.jar /opt/extra-jars/

# dbt (dbt-clickhouse) in an isolated venv so its deps don't collide with Airflow's
# pinned stack. The silver/gold DAG invokes it as /opt/dbt-venv/bin/dbt.
RUN python3 -m venv /opt/dbt-venv && \
    /opt/dbt-venv/bin/pip install --no-cache-dir "dbt-clickhouse>=1.8,<1.9"

# Copy Airflow initialization script
COPY airflow-init.sh /opt/airflow/init.sh
RUN chmod +x /opt/airflow/init.sh

# Switch back to airflow user
USER airflow

# Install Python dependencies for DAGs
ARG AIRFLOW_VERSION=2.10.5
ARG PYTHON_VERSION=3.10
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt"
